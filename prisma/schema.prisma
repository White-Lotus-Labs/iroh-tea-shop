generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String    @id @default(uuid())
  nickname     String
  nicknameKey  String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  chats        Chat[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Chat {
  id                   String    @id @default(uuid())
  userId               String
  title                String    @default("New chat")
  nansenConversationId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages             Message[]

  @@index([userId, updatedAt])
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    String
  role      String
  content   String
  status    String   @default("complete")
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, id])
}

/// Saved Nansen readings. Visitors read these rows. A background refresh rewrites them.
model NansenSnapshot {
  key          String   @id
  payload      String
  fetchedAt    DateTime
  stale        Boolean  @default(false)
  refreshError String?
  updatedAt    DateTime @updatedAt
}
